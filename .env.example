# Server side only. Never expose to the browser.
ANTHROPIC_API_KEY=
# Cache and rate limits across serverless instances. Without it the process memory is used.
DATABASE_URL=
# Salt for pseudonymous ids and hashed client addresses
PSEUDONYM_SALT=
# Optional
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
RATE_LIMIT_PER_HOUR=30
DAILY_LLM_CAP=250
