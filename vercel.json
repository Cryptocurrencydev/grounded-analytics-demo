{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "framework": null,
  "installCommand": "npm ci --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist/frontend/browser",
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "includeFiles": "{grounded/**,data/responses.parquet,data/applications.json,data/precomputed.json}",
      "excludeFiles": "{frontend/**,e2e/**,tests/**,eval/**,scripts/**,data/comments.parquet,.github/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
